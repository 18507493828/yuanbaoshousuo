{
  "name": "yuanbao-stocklens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "StockLens 选股线索台 —— 用元宝搜索把公开信息聚合成可核查的选股线索",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --watch server/index.js\" \"vite\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "doctor": "node scripts/doctor.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^5.4.11"
  }
}
