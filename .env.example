# 两种鉴权方式，配其中一组即可；两组都配时优先用 WSA_API_KEY。

# ── 方式一：服务 API KEY（推荐。权限只限元宝搜索，泄露影响面小）──
# 腾讯云控制台 → 元宝搜索 → 服务 API KEY，形如 sk-xxxxxxxx
WSA_API_KEY=
WSA_ENDPOINT=https://api.wsa.cloud.tencent.com/SearchPro

# ── 方式二：腾讯云 SecretId / SecretKey（TC3-HMAC-SHA256 签名，走标准入口）──
# 注意：主账号密钥拥有整个账号的权限，只在本机调试用，别提交到仓库
WSA_SECRET_ID=
WSA_SECRET_KEY=

# ── 可选：混元 Hy4 preview。填了之后在规则引擎之上多跑一层语义提炼 ──
# 只填 API Key 即可（BASE_URL / MODEL 有默认值）；不填则全程走本地规则，功能不受影响
HY4_API_KEY=
HY4_BASE_URL=https://tokenhub.tencentmaas.com/v1
HY4_MODEL=hy4-preview
# 深度思考会吃满 max_tokens 让 content 返回空串，必须保持 disabled
HY4_THINKING=disabled
# 仅在 HY4_THINKING=enabled 时生效
HY4_REASONING_EFFORT=low
HY4_TIMEOUT_MS=30000
# 每轮扫描最多给前几个候选做语义提炼（控制调用量）
HY4_TOP_N=6
# 默认分析角色：master 资深股票分析师 / industry 产业链研究员 / quant 量化选股经理 / risk 风控审查官
# 页面上的角色选择优先，这里只决定不传 persona 时的默认值
HY4_PERSONA=master

# ── 可选：服务端口 ──
PORT=8787
